# Cadena de conexion a PostgreSQL. En local puedes usar un Postgres propio;
# en Vercel, crea una base de datos (Neon, Vercel Postgres o Supabase) y
# pega aqui la connection string que te den (usa el modo "pooled" si existe).
DATABASE_URL="postgresql://usuario:password@host:5432/biodentis?sslmode=require"

SESSION_SECRET="change-this-to-a-long-random-string-in-production"

# URL publica donde queda desplegada la app (se usa para generar enlaces de firma remota)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opcional pero recomendado en produccion: token de Vercel Blob para guardar
# logos e imagenes subidas desde /admin de forma persistente. Se crea solo
# al conectar un "Blob store" en tu proyecto de Vercel (Storage -> Blob).
# Sin este token, las imagenes se guardan en el disco local (no persiste en Vercel).
BLOB_READ_WRITE_TOKEN=""

# Opcional: habilita el asistente de IA (sugerencias CIE-10, redaccion de evolucion, guia de historia clinica)
ANTHROPIC_API_KEY=""
